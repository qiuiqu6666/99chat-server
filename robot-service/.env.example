# ===== robot-service 环境变量 =====
# 复制为 robot-service/.env 并按实际填写（chmod 600 .env）

# HTTP 端口（Nginx 反代目标）
ROBOT_SERVICE_PORT=8091

# App JWT 验签密钥：必须与主服务一致。
# 主服务实际密钥存于主库 chat99 的 app_setting 表：
#   SELECT setting_value FROM app_setting WHERE setting_key='JWT_SECRET';
JWT_SECRET=

# （已弃用）原 Windows 全局密钥 X-Robot-Secret；现改为每台机器独立机器码 X-Machine-Code
# ROBOT_SYNC_SECRET=

# Telegram / 主服务探活调内部机器码接口（与主服务 TELEGRAM_PROBE_SECRET 保持一致）
# ROBOT_PROBE_SECRET=

# 机器人独立库 jiqiren
ROBOT_DB_HOST=127.0.0.1
ROBOT_DB_PORT=3306
ROBOT_DB_NAME=jiqiren
ROBOT_DB_USERNAME=jiqiren
ROBOT_DB_PASSWORD=jiqiren
ROBOT_DB_SSL_MODE=DISABLED

# 代理报表导出目录（独立目录，勿与主服务共用）
ROBOT_AGENT_EXPORT_DIR=data/agent-export
