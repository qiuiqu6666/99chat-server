# Copy to .env and fill in before `docker compose up`.

# LiveKit API credentials (must match livekit.yaml keys / chat99 application.yml)
LIVEKIT_API_KEY=APIxxxxxxxx
LIVEKIT_API_SECRET=replace_with_long_random_secret

# Public WebSocket URL used by apps (after TLS termination)
LIVEKIT_DOMAIN=livekit.example.com

# Optional: YAML keys map for official image (KEY: SECRET)
# LIVEKIT_KEYS=APIxxxxxxxx: replace_with_long_random_secret
